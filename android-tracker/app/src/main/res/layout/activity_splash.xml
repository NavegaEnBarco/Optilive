<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#020D1B">
    <com.optilive.tracker.XBoatSplashView
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:gravity="center" android:orientation="vertical"
        android:paddingHorizontal="74dp" android:paddingBottom="56dp">
        <ProgressBar android:layout_width="match_parent" android:layout_height="3dp"
            style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true"
            android:indeterminateTint="#58CFFF" android:progressBackgroundTint="#16314A" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Cargando..."
            android:textColor="#D9E9F5" android:textSize="13sp" />
        <TextView android:id="@+id/splashVersion" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textColor="#7194AE" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>