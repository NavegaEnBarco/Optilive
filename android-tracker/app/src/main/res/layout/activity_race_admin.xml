<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F9FC"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Días y pruebas" android:textSize="25sp" android:textStyle="bold" android:textColor="#07558A"/>
<EditText android:id="@+id/raceRegattaId" android:layout_width="match_parent" android:layout_height="54dp" android:hint="ID de regata" android:background="@drawable/card_white" android:padding="14dp" android:layout_marginTop="16dp"/>
<EditText android:id="@+id/raceDay" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Día · ej. 1" android:inputType="number" android:background="@drawable/card_white" android:padding="14dp" android:layout_marginTop="8dp"/>
<EditText android:id="@+id/raceNumber" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Prueba · ej. 2" android:inputType="number" android:background="@drawable/card_white" android:padding="14dp" android:layout_marginTop="8dp"/>
<Spinner android:id="@+id/raceStatus" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/card_white" android:layout_marginTop="8dp"/>
<Button android:id="@+id/saveRace" android:layout_width="match_parent" android:layout_height="56dp" android:text="GUARDAR PRUEBA" android:layout_marginTop="14dp"/>
<TextView android:id="@+id/raceResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="12dp" android:textColor="#07558A"/>
</LinearLayout></ScrollView>