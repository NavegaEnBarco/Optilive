<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F3F7FA"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OPTILIVE" android:textColor="#168FA4" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.16" android:layout_marginTop="24dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu perfil de regatista" android:textColor="#12374A" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confirma tus datos antes de entrar." android:textColor="#6B7F8C" android:textSize="15sp" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Número de vela" android:textColor="#36596D" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp"/><EditText android:id="@+id/entrySail" android:layout_width="match_parent" android:layout_height="56dp" android:singleLine="true" android:inputType="textCapCharacters" android:hint="Ej. ESP 1606" android:textColor="#12374A" android:textSize="17sp" android:padding="12dp" android:background="@drawable/profile_input" android:layout_marginTop="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre" android:textColor="#36596D" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp"/><EditText android:id="@+id/entryFirst" android:layout_width="match_parent" android:layout_height="56dp" android:singleLine="true" android:inputType="textPersonName" android:hint="Tu nombre" android:textColor="#12374A" android:textSize="17sp" android:padding="12dp" android:background="@drawable/profile_input" android:layout_marginTop="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apellidos" android:textColor="#36596D" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp"/><EditText android:id="@+id/entryLast" android:layout_width="match_parent" android:layout_height="56dp" android:singleLine="true" android:inputType="textPersonName" android:hint="Tus apellidos" android:textColor="#12374A" android:textSize="17sp" android:padding="12dp" android:background="@drawable/profile_input" android:layout_marginTop="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Categoría" android:textColor="#36596D" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="18dp"/><Spinner android:id="@+id/entryCategory" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/profile_input" android:layout_marginTop="6dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Club" android:textColor="#36596D" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp"/><EditText android:id="@+id/entryClub" android:layout_width="match_parent" android:layout_height="56dp" android:singleLine="true" android:inputType="textCapWords" android:hint="Tu club" android:textColor="#12374A" android:textSize="17sp" android:padding="12dp" android:background="@drawable/profile_input" android:layout_marginTop="6dp"/>
<Button android:id="@+id/entryContinue" android:layout_width="match_parent" android:layout_height="56dp" android:text="Continuar" android:textAllCaps="false" android:textSize="17sp" android:textColor="#FFFFFF" android:backgroundTint="#086EAA" android:layout_marginTop="28dp" android:layout_marginBottom="24dp"/>
</LinearLayout></ScrollView>