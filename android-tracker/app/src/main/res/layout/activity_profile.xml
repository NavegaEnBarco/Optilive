<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#020D1B">
<com.optilive.tracker.XBoatWaveView android:layout_width="match_parent" android:layout_height="match_parent"/>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="38dp" android:paddingTop="12dp" android:paddingBottom="25dp">
<com.optilive.tracker.XBoatLogoView android:layout_width="match_parent" android:layout_height="138dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="━━   ━━   ━━   ━━" android:textColor="#36B7F5" android:textSize="12sp" android:layout_marginTop="0dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu perfil de regatista" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="7dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confirma tus datos antes de entrar." android:gravity="center" android:textColor="#B3C7D8" android:textSize="14sp" android:layout_marginTop="4dp" android:layout_marginBottom="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="69dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/xboat_profile_input" android:layout_marginTop="7dp">
<com.optilive.tracker.XBoatFieldIconView android:layout_width="60dp" android:layout_height="match_parent" android:tag="0"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Número de vela" android:textColor="#BBD0E2" android:textSize="12sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/xboat_profile_input">
<TextView android:id="@+id/entryCountry" android:layout_width="75dp" android:layout_height="match_parent" android:gravity="center" android:text="ESP  ⌄" android:textColor="#FFFFFF" android:textSize="15sp" android:clickable="true" android:focusable="true"/>
<View android:layout_width="1dp" android:layout_height="26dp" android:background="#376484"/>
<EditText android:id="@+id/entrySail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:singleLine="true" android:inputType="number" android:hint="1606" android:textColor="#FFFFFF" android:textColorHint="#7794AC" android:textSize="17sp" android:paddingHorizontal="15dp" android:background="@android:color/transparent"/>
</LinearLayout></LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="69dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/xboat_profile_input" android:layout_marginTop="7dp">
<com.optilive.tracker.XBoatFieldIconView android:layout_width="60dp" android:layout_height="match_parent" android:tag="1"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre" android:textColor="#BBD0E2" android:textSize="12sp"/>
<EditText android:id="@+id/entryFirst" android:layout_width="match_parent" android:layout_height="38dp" android:singleLine="true" android:inputType="textPersonName" android:hint="Tu nombre" android:textColor="#FFFFFF" android:textColorHint="#7794AC" android:textSize="15sp" android:paddingHorizontal="12dp" android:background="@drawable/xboat_profile_input" />
</LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="69dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/xboat_profile_input" android:layout_marginTop="7dp">
<com.optilive.tracker.XBoatFieldIconView android:layout_width="60dp" android:layout_height="match_parent" android:tag="2"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apellidos" android:textColor="#BBD0E2" android:textSize="12sp"/>
<EditText android:id="@+id/entryLast" android:layout_width="match_parent" android:layout_height="38dp" android:singleLine="true" android:inputType="textPersonName" android:hint="Tus apellidos" android:textColor="#FFFFFF" android:textColorHint="#7794AC" android:textSize="15sp" android:paddingHorizontal="12dp" android:background="@drawable/xboat_profile_input" />
</LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="69dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/xboat_profile_input" android:layout_marginTop="7dp">
<com.optilive.tracker.XBoatFieldIconView android:layout_width="60dp" android:layout_height="match_parent" android:tag="3"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CATEGORÍA" android:textColor="#BBD0E2" android:textSize="12sp"/>
<Spinner android:id="@+id/entryCategory" android:layout_width="match_parent" android:layout_height="38dp" android:background="@drawable/xboat_profile_input" android:paddingHorizontal="12dp" android:popupBackground="#0A2947"/>
</LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="69dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/xboat_profile_input" android:layout_marginTop="7dp">
<com.optilive.tracker.XBoatFieldIconView android:layout_width="60dp" android:layout_height="match_parent" android:tag="4"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CLUB" android:textColor="#BBD0E2" android:textSize="12sp"/>
<EditText android:id="@+id/entryClub" android:layout_width="match_parent" android:layout_height="38dp" android:singleLine="true" android:inputType="text" android:hint="Selecciona tu club  ⌄" android:textColor="#FFFFFF" android:textColorHint="#7794AC" android:textSize="15sp" android:paddingHorizontal="12dp" android:background="@drawable/xboat_profile_input" android:focusable="false" android:clickable="true"/>
</LinearLayout></LinearLayout>
<Button android:id="@+id/entryContinue" android:layout_width="match_parent" android:layout_height="48dp" android:text="Continuar    →" android:textAllCaps="false" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/xboat_blue_button" android:backgroundTint="@null" android:layout_marginTop="14dp"/>
</LinearLayout></ScrollView></FrameLayout>