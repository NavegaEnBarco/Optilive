<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#020D1B"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="X  B O A T" android:textColor="#64D2FF" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.16" android:layout_marginTop="24dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PERFIL DEL REGATISTA" android:textColor="#F1F9FF" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Configura tu identidad para navegar." android:textColor="#9BBAD0" android:textSize="15sp" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
<ImageView android:id="@+id/entryAvatar" android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" android:background="@drawable/circle_pale_blue" android:src="@drawable/ic_optilive_sail_outline" android:scaleType="centerCrop" android:contentDescription="Seleccionar foto de perfil"/><TextView android:id="@+id/entryChoosePhoto" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="+ AÑADIR FOTO DE PERFIL" android:textColor="#65CFFF" android:textStyle="bold" android:textSize="12sp" android:padding="12dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Número de vela" android:textColor="#B7D5E9" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp"/><EditText android:id="@+id/entrySail" android:layout_width="match_parent" android:layout_height="56dp" android:singleLine="true" android:inputType="textCapCharacters" android:hint="Ej. ESP 1606" android:textColor="#F1F9FF" android:textSize="17sp" android:padding="12dp" android:background="@drawable/xboat_profile_input" android:layout_marginTop="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre" android:textColor="#B7D5E9" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp"/><EditText android:id="@+id/entryFirst" android:layout_width="match_parent" android:layout_height="56dp" android:singleLine="true" android:inputType="textPersonName" android:hint="Tu nombre" android:textColor="#F1F9FF" android:textSize="17sp" android:padding="12dp" android:background="@drawable/xboat_profile_input" android:layout_marginTop="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apellidos" android:textColor="#B7D5E9" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp"/><EditText android:id="@+id/entryLast" android:layout_width="match_parent" android:layout_height="56dp" android:singleLine="true" android:inputType="textPersonName" android:hint="Tus apellidos" android:textColor="#F1F9FF" android:textSize="17sp" android:padding="12dp" android:background="@drawable/xboat_profile_input" android:layout_marginTop="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Categoría" android:textColor="#B7D5E9" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="18dp"/><Spinner android:id="@+id/entryCategory" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/xboat_profile_input" android:layout_marginTop="6dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Club" android:textColor="#B7D5E9" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp"/><EditText android:id="@+id/entryClub" android:layout_width="match_parent" android:layout_height="56dp" android:singleLine="true" android:inputType="textCapWords" android:hint="Tu club" android:textColor="#F1F9FF" android:textSize="17sp" android:padding="12dp" android:background="@drawable/xboat_profile_input" android:layout_marginTop="6dp"/>
<Button android:id="@+id/entryContinue" android:layout_width="match_parent" android:layout_height="56dp" android:text="GUARDAR Y CONTINUAR" android:textAllCaps="false" android:textSize="17sp" android:textColor="#FFFFFF" android:backgroundTint="#087DEB" android:layout_marginTop="28dp" android:layout_marginBottom="24dp"/>
</LinearLayout></ScrollView>