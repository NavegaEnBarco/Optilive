<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F4F7FA">
 <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#075A91" android:paddingHorizontal="16dp">
  <TextView android:id="@+id/backTracking" android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:text="☰" android:textColor="#FFFFFF" android:textSize="28sp"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OptiLive" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Regata en directo" android:textColor="#D7F0FF" android:textSize="13sp"/>
  </LinearLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♙   ▣   ⚙" android:textColor="#FFFFFF" android:textSize="23sp"/>
 </LinearLayout>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <WebView android:id="@+id/webMap" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:layout_gravity="top" android:layout_margin="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:background="@drawable/card_white">
   <TextView android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:text="⚑" android:textColor="#1689E8" android:textSize="28sp"/>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/raceName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Regata OptiLive" android:textStyle="bold" android:textSize="16sp" android:textColor="#18232F"/>
    <TextView android:id="@+id/raceClub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="En directo" android:textSize="13sp" android:textColor="#617286"/>
   </LinearLayout>
   <TextView android:id="@+id/liveStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LIVE" android:textColor="#10A875" android:textStyle="bold"/>
  </LinearLayout>
  <LinearLayout android:layout_width="50dp" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:layout_marginRight="12dp" android:orientation="vertical">
   <TextView android:id="@+id/centerMap" android:layout_width="50dp" android:layout_height="50dp" android:gravity="center" android:text="⌾" android:textSize="27sp" android:textColor="#075A91" android:background="@drawable/card_white"/>
   <TextView android:id="@+id/zoomIn" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginTop="8dp" android:gravity="center" android:text="+" android:textSize="30sp" android:textColor="#075A91" android:background="@drawable/card_white"/>
   <TextView android:id="@+id/zoomOut" android:layout_width="50dp" android:layout_height="50dp" android:gravity="center" android:text="−" android:textSize="30sp" android:textColor="#075A91" android:background="@drawable/card_white"/>
  </LinearLayout>
 </FrameLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:orientation="horizontal" android:background="#FFFFFF">
  <LinearLayout android:id="@+id/mapNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_nav_map"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mapa" android:textColor="#1689E8" android:textStyle="bold" android:textSize="11sp"/></LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆" android:textSize="22sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clasificación" android:textColor="#617286" android:textSize="10sp"/></LinearLayout>
  <LinearLayout android:id="@+id/trackingNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_nav_home"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seguimiento" android:textColor="#617286" android:textSize="10sp"/></LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_nav_more"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opciones" android:textColor="#617286" android:textSize="10sp"/></LinearLayout>
 </LinearLayout>
</LinearLayout>