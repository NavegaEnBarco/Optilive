<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F4F7FA">
 <LinearLayout android:layout_width="match_parent" android:layout_height="84dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#075A91" android:paddingHorizontal="18dp">
  <TextView android:id="@+id/backTracking" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="☰" android:textColor="#FFFFFF" android:textSize="30sp"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="8dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OptiLive" android:textColor="#FFFFFF" android:textSize="29sp" android:textStyle="bold"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Regata en directo" android:textColor="#D8EAF6" android:textSize="14sp"/>
  </LinearLayout>
  <TextView android:layout_width="132dp" android:layout_height="match_parent" android:gravity="center" android:text="♟♟   ▣   ⚙" android:textColor="#FFFFFF" android:textSize="24sp"/>
 </LinearLayout>

 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <WebView android:id="@+id/webMap" android:layout_width="match_parent" android:layout_height="match_parent"/>

  <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:layout_gravity="top" android:layout_marginLeft="12dp" android:layout_marginTop="10dp" android:layout_marginRight="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:background="@drawable/card_white">
   <TextView android:layout_width="42dp" android:layout_height="match_parent" android:gravity="center" android:text="⚑" android:textColor="#087FE3" android:textSize="31sp"/>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/raceName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trofeo Fornells 2026" android:textStyle="bold" android:textSize="17sp" android:textColor="#151C25"/>
    <TextView android:id="@+id/raceClub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C.M. Mahón" android:textSize="14sp" android:textColor="#667382"/>
   </LinearLayout>
   <LinearLayout android:layout_width="92dp" android:layout_height="match_parent" android:gravity="center_vertical|end" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prueba 2/4" android:textSize="13sp" android:textColor="#4F5A68"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:24:17" android:textStyle="bold" android:textSize="16sp" android:textColor="#111820"/>
    <TextView android:id="@+id/liveStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● En directo" android:textColor="#10A875" android:textSize="11sp"/>
   </LinearLayout>
  </LinearLayout>

  <LinearLayout android:layout_width="52dp" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:layout_marginRight="12dp" android:orientation="vertical">
   <TextView android:id="@+id/centerMap" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="⌾" android:textSize="29sp" android:textColor="#075A91" android:background="@drawable/card_white"/>
   <TextView android:id="@+id/zoomIn" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginTop="9dp" android:gravity="center" android:text="+" android:textSize="31sp" android:textColor="#075A91" android:background="@drawable/card_white"/>
   <TextView android:id="@+id/zoomOut" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="−" android:textSize="31sp" android:textColor="#075A91" android:background="@drawable/card_white"/>
   <TextView android:layout_width="52dp" android:layout_height="52dp" android:layout_marginTop="9dp" android:gravity="center" android:text="▱" android:textSize="26sp" android:textColor="#075A91" android:background="@drawable/card_white"/>
  </LinearLayout>

  <TextView android:layout_width="178dp" android:layout_height="48dp" android:layout_gravity="bottom|end" android:layout_marginRight="14dp" android:layout_marginBottom="84dp" android:gravity="center" android:text="≋  Viento 12 kn   → NE" android:textColor="#3C4C5B" android:textSize="13sp" android:background="@drawable/card_white"/>

  <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:background="#F8FFFFFF">
   <TextView android:layout_width="50dp" android:layout_height="match_parent" android:gravity="center" android:text="Ⅱ" android:textColor="#087FE3" android:textSize="34sp" android:textStyle="bold"/>
   <SeekBar android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:progress="42"/>
   <TextView android:layout_width="74dp" android:layout_height="match_parent" android:gravity="center" android:text="00:24:17" android:textColor="#465565" android:textSize="14sp"/>
   <TextView android:layout_width="58dp" android:layout_height="match_parent" android:gravity="center" android:text="● LIVE" android:textColor="#10A875" android:textStyle="bold" android:textSize="13sp"/>
  </LinearLayout>
 </FrameLayout>

 <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:background="#FFFFFF">
  <LinearLayout android:id="@+id/mapNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_nav_map"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mapa" android:textColor="#1689E8" android:textStyle="bold" android:textSize="11sp"/></LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆" android:textSize="23sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clasificación" android:textColor="#617286" android:textSize="10sp"/></LinearLayout>
  <LinearLayout android:id="@+id/trackingNav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♟♟" android:textSize="22sp" android:textColor="#617286"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seguimiento" android:textColor="#617286" android:textSize="10sp"/></LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_nav_more"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opciones" android:textColor="#617286" android:textSize="10sp"/></LinearLayout>
 </LinearLayout>
</LinearLayout>