<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F9FC"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Campo de regatas" android:textSize="25sp" android:textStyle="bold" android:textColor="#07558A"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Asigna cada dispositivo GPS a una boya" android:textColor="#6B7B8C" android:layout_marginBottom="16dp"/>
<EditText android:id="@+id/regattaId" android:layout_width="match_parent" android:layout_height="54dp" android:hint="ID de regata" android:background="@drawable/card_white" android:padding="14dp"/>
<EditText android:id="@+id/markDevice" android:layout_width="match_parent" android:layout_height="54dp" android:hint="ID GPS · ej. BUOY-03" android:background="@drawable/card_white" android:padding="14dp" android:layout_marginTop="8dp"/>
<EditText android:id="@+id/markName" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Nombre · ej. Barlovento 1" android:background="@drawable/card_white" android:padding="14dp" android:layout_marginTop="8dp"/>
<Spinner android:id="@+id/markType" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/card_white" android:layout_marginTop="8dp"/>
<Button android:id="@+id/assignMark" android:layout_width="match_parent" android:layout_height="56dp" android:text="ASIGNAR GPS A BOYA" android:layout_marginTop="14dp"/>
<TextView android:id="@+id/markResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="12dp" android:textColor="#07558A"/>
</LinearLayout></ScrollView>