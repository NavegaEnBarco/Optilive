<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F7F9FC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#FFFFFF" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="8dp" android:paddingBottom="8dp">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="⛵  OptiLive\n      TRACKING OPTIMIST" android:textColor="#07558A" android:textSize="22sp" android:textStyle="bold"/>
  <TextView android:id="@+id/topSettings" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⚙" android:textSize="27sp" android:textColor="#07558A"/>
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="10dp" android:paddingBottom="8dp">
   <TextView android:id="@+id/sailDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_white" android:padding="12dp" android:text="🇪🇸  ESP ----" android:textColor="#102A43" android:textSize="23sp" android:textStyle="bold"/>
   <TextView android:id="@+id/sailorDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Regatista&#10;Categoría  |  Club" android:textColor="#536273" android:textSize="15sp" android:paddingLeft="14dp" android:paddingTop="4dp" android:layout_marginBottom="7dp"/>
   <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_green" android:padding="11dp" android:text="●  GPS DETENIDO&#10;Esperando señal" android:textColor="#087F5B" android:textSize="16sp" android:textStyle="bold"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
    <TextView android:id="@+id/speedDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="82dp" android:gravity="center" android:background="@drawable/card_white" android:text="0,0&#10;nudos&#10;Velocidad" android:textColor="#102A43" android:textSize="15sp" android:textStyle="bold"/>
    <Space android:layout_width="8dp" android:layout_height="1dp"/>
    <TextView android:id="@+id/distanceDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="82dp" android:gravity="center" android:background="@drawable/card_white" android:text="0&#10;m&#10;Distancia recorrida" android:textColor="#102A43" android:textSize="15sp" android:textStyle="bold"/>
   </LinearLayout>
   <TextView android:id="@+id/telemetry" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
    <TextView android:id="@+id/sentDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp" android:gravity="center" android:background="@drawable/card_white" android:text="0&#10;posiciones enviadas"/>
    <Space android:layout_width="8dp" android:layout_height="1dp"/>
    <TextView android:id="@+id/pendingDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp" android:gravity="center" android:background="@drawable/card_white" android:text="0&#10;pendientes (offline)"/>
   </LinearLayout>
   <TextView android:id="@+id/serverStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_white" android:padding="11dp" android:text="Servidor: esperando datos" android:textColor="#334E68" android:textSize="15sp" android:layout_marginTop="8dp"/>
   <Button android:id="@+id/startTracking" android:layout_width="match_parent" android:layout_height="54dp" android:text="▶  INICIAR SEGUIMIENTO" android:textSize="17sp" android:layout_marginTop="8dp"/>
   <TextView android:id="@+id/stopTracking" android:gravity="center" android:layout_width="match_parent" android:layout_height="50dp" android:text="■  DETENER SEGUIMIENTO" android:textColor="#E03131" android:background="@drawable/button_stop"/>
   <TextView android:id="@+id/lastPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="5dp" android:text="Última posición: --:--:--" android:textColor="#7A8795"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:background="@drawable/card_white">
    <TextView android:id="@+id/latDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Latitud&#10;--"/>
    <TextView android:id="@+id/lonDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Longitud&#10;--"/>
    <TextView android:id="@+id/accuracyDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Precisión&#10;--"/>
   </LinearLayout>
   <TextView android:id="@+id/coordinates" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp"/>
   <LinearLayout android:id="@+id/settingsPanel" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AJUSTES DEL REGATISTA" android:textColor="#07558A" android:textStyle="bold"/>
    <EditText android:id="@+id/sailNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Número de vela"/>
    <EditText android:id="@+id/firstName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre"/>
    <EditText android:id="@+id/lastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Apellidos"/>
    <EditText android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Categoría"/>
    <EditText android:id="@+id/club" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Club"/>
    <EditText android:id="@+id/serverUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Servidor OptiLive"/>
    <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GUARDAR AJUSTES"/>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:background="#FFFFFF">
  <TextView android:id="@+id/homeButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="⌂&#10;Seguimiento" android:textColor="#1689E8"/>
  <TextView android:id="@+id/racesButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="⚑&#10;Regatas"/>
  <TextView android:id="@+id/mapButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="◈&#10;Mapa"/>
  <TextView android:id="@+id/historyButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="◴&#10;Historial"/>
  <TextView android:id="@+id/settingsButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="•••&#10;Más"/>
 </LinearLayout>
</LinearLayout>