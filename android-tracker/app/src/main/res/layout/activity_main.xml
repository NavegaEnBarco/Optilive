<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F7F9FC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#FFFFFF" android:paddingHorizontal="16dp">
  <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_launcher_optilive" />
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="8dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OptiLive" android:textColor="#07558A" android:textSize="25sp" android:textStyle="bold" />
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRACKING OPTIMIST" android:textColor="#6B7B8C" android:textSize="10sp" android:letterSpacing=".08" />
  </LinearLayout>
  <ImageView android:id="@+id/topSettings" android:layout_width="42dp" android:layout_height="42dp" android:padding="8dp" android:src="@drawable/ic_settings_blue" />
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingTop="8dp" android:paddingBottom="24dp">
   <FrameLayout android:layout_width="match_parent" android:layout_height="224dp" android:background="@drawable/card_profile" android:clipToOutline="true" android:outlineProvider="background" android:padding="0dp">
    <ImageView android:id="@+id/profileCover" android:layout_width="match_parent" android:layout_height="130dp" android:scaleType="centerCrop" android:src="@drawable/ic_optilive_sail_outline" android:background="#DDEFFC" android:padding="38dp" />
    <ImageView android:id="@+id/changePhoto" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|right" android:layout_marginTop="12dp" android:layout_marginRight="12dp" android:gravity="center" android:textColor="#087FE3" android:textStyle="bold" android:background="@drawable/card_white" android:src="@drawable/ic_edit_profile" android:padding="10dp" android:contentDescription="Editar portada" />
    <ImageView android:id="@+id/profilePhoto" android:layout_width="94dp" android:layout_height="94dp" android:layout_gravity="left|bottom" android:clipToOutline="true" android:outlineProvider="background" android:layout_marginLeft="12dp" android:layout_marginBottom="14dp" android:scaleType="centerCrop" android:src="@drawable/ic_optilive_sail_outline" android:background="@drawable/circle_pale_blue" android:padding="18dp" />
    <ImageView android:id="@+id/photoBadge" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="left|bottom" android:layout_marginLeft="82dp" android:layout_marginBottom="12dp" android:gravity="center" android:background="@drawable/circle_pale_blue" android:src="@drawable/ic_edit_profile" android:padding="10dp" android:contentDescription="Editar foto de perfil" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="120dp" android:paddingRight="10dp">
     <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/sailDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ESP ----" android:textColor="#101820" android:textSize="22sp" android:textStyle="bold" />
      <TextView android:id="@+id/sailorDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Regatista&#10;Categoría | Club" android:textColor="#536273" android:textSize="14sp" />
     </LinearLayout>
     </LinearLayout>
   </FrameLayout>
   <Button android:id="@+id/startTracking" android:layout_width="match_parent" android:layout_height="56dp" android:text="▶  INICIAR SEGUIMIENTO" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:backgroundTint="#1689E8" android:layout_marginTop="12dp" />
   <TextView android:id="@+id/trackingState" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Seguimiento detenido" android:textSize="12sp" android:textColor="#7A8795" android:paddingBottom="4dp" android:paddingTop="4dp" /><LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:orientation="horizontal" android:layout_marginTop="8dp" android:visibility="gone">
    <TextView android:id="@+id/profileBoat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="⛵ ESP ----" android:textColor="#102A43" android:textStyle="bold" android:background="@drawable/card_white" />
    <Space android:layout_width="6dp" android:layout_height="1dp" />
    <TextView android:id="@+id/profileCategory" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="👥 Sub11" android:textColor="#102A43" android:textStyle="bold" android:background="@drawable/card_white" />
    <Space android:layout_width="6dp" android:layout_height="1dp" />
    <TextView android:id="@+id/profileClub" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="⚑ Club" android:textColor="#102A43" android:textStyle="bold" android:background="@drawable/card_white" />
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/card_white" android:paddingHorizontal="14dp" android:layout_marginTop="8dp" android:id="@+id/gpsCard" android:minHeight="66dp" android:paddingVertical="10dp">
    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_satellite" android:tint="#10A875" />
    <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingLeft="10dp" android:text="GPS detenido" android:textColor="#087F5B" android:textSize="14sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center"><TextView android:id="@+id/satelliteDisplay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:text="— satélites" android:textColor="#087F5B" android:textSize="12sp" android:textStyle="bold" /></LinearLayout>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal" android:layout_marginTop="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:background="@drawable/card_white" android:paddingHorizontal="10dp" android:paddingVertical="12dp">
     <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_speed" />
     <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="8dp"><TextView android:id="@+id/speedDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#102A43" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Velocidad" android:textSize="13sp" android:textColor="#7A8795" /></LinearLayout></LinearLayout>
    <Space android:layout_width="8dp" android:layout_height="1dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:background="@drawable/card_white" android:paddingHorizontal="10dp" android:paddingVertical="12dp">
     <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_route" />
     <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="8dp"><TextView android:id="@+id/distanceDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#102A43" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Distancia" android:textSize="13sp" android:textColor="#7A8795" /></LinearLayout></LinearLayout>
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/card_white" android:paddingHorizontal="14dp" android:layout_marginTop="8dp" android:minHeight="84dp" android:paddingVertical="14dp">
    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_wifi" />
    <TextView android:id="@+id/serverStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingLeft="10dp" android:text="Conexión sin comprobar" android:textColor="#193D50" android:textSize="13sp" />
    </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:background="@drawable/card_white" android:minHeight="76dp" android:paddingVertical="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
     <TextView android:id="@+id/sentDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textColor="#334E68" android:textSize="26sp" android:gravity="center" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Posiciones enviadas" android:textColor="#7A8795" android:textSize="12sp" /></LinearLayout>
    <Space android:layout_width="8dp" android:layout_height="1dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
     <TextView android:id="@+id/pendingDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textColor="#334E68" android:textSize="26sp" android:gravity="center" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Pendientes" android:textColor="#7A8795" android:textSize="12sp" /></LinearLayout>
   </LinearLayout>
   <TextView android:id="@+id/stopTracking" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="■   DETENER SEGUIMIENTO" android:textColor="#F0444C" android:textStyle="bold" android:background="@drawable/button_stop" android:layout_marginTop="6dp" android:visibility="gone" />
   <TextView android:id="@+id/coordinates" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
   <TextView android:id="@+id/telemetry" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Datos de la sesión de seguimiento" android:gravity="center" android:textSize="11sp" android:textColor="#7A8795" android:layout_marginTop="10dp" /><LinearLayout android:id="@+id/settingsPanel" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/card_white" android:layout_marginTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:background="@drawable/card_white">
    <TextView android:id="@+id/latDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Latitud&#10;--" android:textColor="#536273" android:textSize="12sp" />
    <TextView android:id="@+id/lonDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Longitud&#10;--" android:textColor="#536273" android:textSize="12sp" />
    <TextView android:id="@+id/accuracyDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Precisión&#10;--" android:textColor="#536273" android:textSize="12sp" />
   </LinearLayout>
   <TextView android:id="@+id/lastPosition" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center" android:text="Última posición: --:--:--" android:textColor="#7A8795" android:textSize="12sp" />
   <EditText android:id="@+id/sailNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Número de vela" />
    <EditText android:id="@+id/firstName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre" />
    <EditText android:id="@+id/lastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Apellidos" />
    <Spinner android:id="@+id/category" android:layout_width="match_parent" android:layout_height="52dp" android:spinnerMode="dropdown" />
    <EditText android:id="@+id/club" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Club" />
    <EditText android:id="@+id/serverUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Servidor OptiLive" />
    <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GUARDAR AJUSTES" />
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:background="#FFFFFF">
  <LinearLayout android:id="@+id/homeButton" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_nav_home" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Seguimiento" android:textColor="#1689E8" android:textSize="10sp" /></LinearLayout>
  <LinearLayout android:id="@+id/racesButton" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_nav_flag" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Regatas" android:textColor="#617286" android:textSize="10sp" /></LinearLayout>
  <LinearLayout android:id="@+id/mapButton" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_nav_map" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Mapa" android:textColor="#617286" android:textSize="10sp" /></LinearLayout>
  <LinearLayout android:id="@+id/historyButton" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_nav_history" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Historial" android:textColor="#617286" android:textSize="10sp" /></LinearLayout>
  <LinearLayout android:id="@+id/settingsButton" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_nav_more" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Más" android:textColor="#617286" android:textSize="10sp" /></LinearLayout>
 </LinearLayout>
</LinearLayout>