<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F4F7FA">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#07558A" android:padding="20dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OptiLive" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRACKING OPTIMIST · PRO" android:textColor="#BDE8FF" android:textSize="12sp"/>
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
   <TextView android:id="@+id/sailDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ESP ----" android:textColor="#102A43" android:textSize="28sp" android:textStyle="bold"/>
   <TextView android:id="@+id/sailorDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Regatista · Categoría · Club" android:textColor="#627D98" android:textSize="16sp" android:layout_marginBottom="14dp"/>
   <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#E5F8EF" android:padding="15dp" android:text="GPS DETENIDO" android:textColor="#087F5B" android:textSize="19sp" android:textStyle="bold"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
    <TextView android:id="@+id/speedDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="110dp" android:gravity="center" android:background="#FFFFFF" android:text="0.0 kn\nVELOCIDAD" android:textColor="#102A43" android:textSize="18sp" android:textStyle="bold"/>
    <Space android:layout_width="8dp" android:layout_height="1dp"/>
    <TextView android:id="@+id/distanceDisplay" android:layout_width="0dp" android:layout_weight="1" android:layout_height="110dp" android:gravity="center" android:background="#FFFFFF" android:text="0 m\nDISTANCIA" android:textColor="#102A43" android:textSize="18sp" android:textStyle="bold"/>
   </LinearLayout>
   <TextView android:id="@+id/telemetry" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp"/>
   <TextView android:id="@+id/serverStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:padding="15dp" android:text="Servidor: esperando datos" android:textColor="#334E68" android:textSize="15sp" android:layout_marginTop="8dp"/>
   <Button android:id="@+id/startTracking" android:layout_width="match_parent" android:layout_height="62dp" android:text="▶  INICIAR SEGUIMIENTO" android:textSize="17sp" android:layout_marginTop="14dp"/>
   <Button android:id="@+id/stopTracking" android:layout_width="match_parent" android:layout_height="56dp" android:text="■  FINALIZAR SEGUIMIENTO"/>
   <TextView android:id="@+id/coordinates" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:padding="14dp" android:text="Esperando posición..." android:textColor="#627D98" android:textSize="14sp" android:layout_marginTop="8dp"/>
   <LinearLayout android:id="@+id/settingsPanel" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AJUSTES DEL REGATISTA" android:textColor="#07558A" android:textStyle="bold"/>
    <EditText android:id="@+id/sailNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Número de vela"/>
    <EditText android:id="@+id/firstName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre"/>
    <EditText android:id="@+id/lastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Apellidos"/>
    <EditText android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Categoría"/>
    <EditText android:id="@+id/club" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Club"/>
    <EditText android:id="@+id/serverUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Servidor OptiLive"/>
    <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GUARDAR AJUSTES"/>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:orientation="horizontal" android:background="#FFFFFF" android:gravity="center">
  <Button android:id="@+id/homeButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="⌂\nSEGUIR" android:textSize="11sp"/>
  <Button android:id="@+id/mapButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="⌖\nMAPA" android:textSize="11sp"/>
  <Button android:id="@+id/settingsButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="⚙\nAJUSTES" android:textSize="11sp"/>
 </LinearLayout>
</LinearLayout>