<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OptiLive" android:textSize="32sp" android:textStyle="bold"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perfil del regatista" android:textSize="18sp" android:layout_marginBottom="12dp"/>
  <EditText android:id="@+id/sailNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Número de vela"/>
  <EditText android:id="@+id/firstName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre"/>
  <EditText android:id="@+id/lastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Apellidos"/>
  <EditText android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Categoría"/>
  <EditText android:id="@+id/club" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Club"/>
  <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Guardar perfil" android:layout_marginTop="12dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seguimiento GPS" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="28dp"/>
  <Button android:id="@+id/startTracking" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INICIAR SEGUIMIENTO"/>
  <Button android:id="@+id/stopTracking" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DETENER SEGUIMIENTO"/>
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GPS detenido" android:textSize="16sp" android:layout_marginTop="16dp"/>
  <TextView android:id="@+id/coordinates" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Esperando posición..." android:textSize="15sp" android:layout_marginTop="8dp"/>
 </LinearLayout>
</ScrollView>
