<EditText android:id="@+id/adminPass" android:layout_width="match_parent" android:layout_height="54dp" android:hint="Contraseña" android:inputType="textPassword" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#8CAEC8" android:layout_marginTop="9dp" android:background="@drawable/xboat_settings_field"/>
<Button android:id="@+id/adminLogin" android:layout_width="match_parent" android:layout_height="54dp" android:text="ACCEDER" android:layout_marginTop="12dp" android:background="@drawable/xboat_blue_button" android:backgroundTint="@null" android:textColor="#FFFFFF"/>
</LinearLayout>
<TextView android:id="@+id/adminMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF9C9C" android:gravity="center" android:layout_marginTop="8dp"/>
<LinearLayout android:id="@+id/adminPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
