<LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/xboat_settings_group" android:paddingHorizontal="12dp" android:layout_marginTop="12dp"><TextView android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="⚑" android:textSize="29sp" android:textColor="#19BFFF" android:background="@drawable/xboat_settings_field"/><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Balizador" android:textSize="17sp" android:textColor="#FFFFFF" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gestionar boyas y recorrido" android:textSize="12sp" android:textColor="#AAC7DF" android:layout_marginTop="4dp"/></LinearLayout><Button android:id="@+id/roleBuoy" android:layout_width="46dp" android:layout_height="58dp" android:backgroundTint="@android:color/transparent" android:text="›" android:textSize="32sp" android:textColor="#12C4FF" android:contentDescription="Balizador"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/xboat_settings_group" android:paddingHorizontal="12dp" android:layout_marginTop="12dp"><TextView android:layout_width="54dp" android:layout_height="54dp" android:gravity="center" android:text="♟" android:textSize="29sp" android:textColor="#19BFFF" android:background="@drawable/xboat_settings_field"/><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Club" android:textSize="17sp" android:textColor="#FFFFFF" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seguimiento y resultados" android:textSize="12sp" android:textColor="#AAC7DF" android:layout_marginTop="4dp"/></LinearLayout><Button android:id="@+id/roleClub" android:layout_width="46dp" android:layout_height="58dp" android:backgroundTint="@android:color/transparent" android:text="›" android:textSize="32sp" android:textColor="#12C4FF" android:contentDescription="Club"/></LinearLayout>
<TextView android:id="@+id/roleDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elige un perfil para continuar" android:textColor="#A7C3D9" android:textSize="13sp" android:paddingTop="12dp" android:paddingHorizontal="8dp"/>
<LinearLayout android:id="@+id/loginFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
