<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/admin_nautical_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="740dp" android:orientation="vertical" android:padding="22dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OptiLive" android:textSize="37sp" android:textStyle="bold" android:textColor="#075A91" android:gravity="center" android:layout_marginTop="32dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GPS TRACKER" android:textSize="14sp" android:letterSpacing=".22" android:textStyle="bold" android:textColor="#139DC5" android:gravity="center"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Administración de regata" android:textSize="24sp" android:textStyle="bold" android:textColor="#0A3659" android:gravity="center" android:layout_marginTop="34dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Acceso exclusivo según tu rol" android:textSize="14sp" android:textColor="#5E7D91" android:gravity="center" android:layout_marginBottom="22dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_white" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selecciona tu perfil" android:textStyle="bold" android:textSize="18sp" android:textColor="#123D5D" android:layout_marginBottom="12dp"/>
<Button android:id="@+id/roleAdmin" android:layout_width="match_parent" android:layout_height="74dp" android:gravity="center_vertical" android:backgroundTint="#DDEFFC" android:textColor="#075A91" android:textAllCaps="false" android:textSize="17sp" android:text="⚙   Administrador     ›"/>
<Button android:id="@+id/roleBuoy" android:layout_width="match_parent" android:layout_height="74dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:backgroundTint="#E2F6F3" android:textColor="#087D78" android:textAllCaps="false" android:textSize="17sp" android:text="⚑   Balizador             ›"/>
<Button android:id="@+id/roleClub" android:layout_width="match_parent" android:layout_height="74dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:backgroundTint="#F0EAFE" android:textColor="#6750A4" android:textAllCaps="false" android:textSize="17sp" android:text="♧   Club                    ›"/>
<TextView android:id="@+id/roleDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elige un perfil para continuar" android:textColor="#607D90" android:textSize="13sp" android:paddingTop="12dp"/>
<LinearLayout android:id="@+id/loginFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
<EditText android:id="@+id/adminUser" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Nombre de usuario" android:inputType="text" android:paddingHorizontal="16dp" android:background="@drawable/card_white"/>
<EditText android:id="@+id/adminPass" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Contraseña" android:inputType="textPassword" android:paddingHorizontal="16dp" android:layout_marginTop="8dp" android:background="@drawable/card_white"/>
<Button android:id="@+id/adminLogin" android:layout_width="match_parent" android:layout_height="56dp" android:text="ACCEDER" android:layout_marginTop="10dp" android:backgroundTint="#087CAF" android:textColor="#FFFFFF"/>
</LinearLayout>
<TextView android:id="@+id/adminMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C62828" android:gravity="center" android:layout_marginTop="8dp"/>
<LinearLayout android:id="@+id/adminPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Panel de gestión" android:textStyle="bold" android:textSize="20sp" android:textColor="#102A43"/>
<Button android:id="@+id/newRegatta" android:layout_width="match_parent" android:layout_height="54dp" android:text="+ NUEVA REGATA"/>
<Button android:id="@+id/manageRaces" android:layout_width="match_parent" android:layout_height="54dp" android:text="DÍAS Y PRUEBAS"/>
<Button android:id="@+id/manageCourse" android:layout_width="match_parent" android:layout_height="54dp" android:text="CAMPO DE REGATAS · BOYAS GPS"/>
</LinearLayout>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Acceso exclusivo para Organización / Clubes" android:textColor="#5D8198" android:textSize="12sp" android:layout_marginTop="28dp"/>
</LinearLayout></ScrollView>