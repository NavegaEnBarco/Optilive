<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F5F8FC">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="290dp" android:background="#095B91">
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/splash_optilive" android:scaleType="centerCrop" android:contentDescription="OptiLive, navegación Optimist"/>
<View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#70003A69"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="◢  OptiLive" android:textSize="36sp" android:textColor="#FFFFFF" android:textStyle="bold" android:gravity="center" android:layout_marginTop="6dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GPS TRACKER" android:textSize="14sp" android:letterSpacing=".22" android:textColor="#BDEBFF" android:gravity="center"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Administración\nde regata" android:textSize="29sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginTop="26dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Acceso exclusivo según tu rol" android:textSize="16sp" android:textColor="#E0F2FF" android:layout_marginTop="6dp"/>
</LinearLayout></FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="#F8FAFE">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selecciona tu tipo de acceso" android:textColor="#0A315F" android:textSize="21sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cada perfil tiene funciones específicas para la organización de la regata." android:textColor="#65758D" android:textSize="15sp" android:layout_marginTop="5dp" android:layout_marginBottom="18dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_white" android:padding="8dp">
<Button android:id="@+id/roleAdmin" android:layout_width="match_parent" android:layout_height="96dp" android:backgroundTint="#E7F3FF" android:textColor="#0A3161" android:textAllCaps="false" android:textSize="17sp" android:textStyle="bold" android:gravity="center_vertical" android:text="⚙    Administrador                       ›"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gestión completa de la regata, usuarios, barcos, balizas y resultados." android:textSize="13sp" android:textColor="#5E6E85" android:paddingStart="54dp" android:paddingEnd="12dp" android:layout_marginBottom="12dp"/>
<Button android:id="@+id/roleBuoy" android:layout_width="match_parent" android:layout_height="86dp" android:backgroundTint="#FFF1DF" android:textColor="#C76810" android:textAllCaps="false" android:textSize="17sp" android:textStyle="bold" android:gravity="center_vertical" android:text="⚑    Balizador                               ›"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gestión de balizas, posiciones, recorridos y marcaje en tiempo real." android:textSize="13sp" android:textColor="#5E6E85" android:paddingStart="54dp" android:paddingEnd="12dp" android:layout_marginBottom="12dp"/>
<Button android:id="@+id/roleClub" android:layout_width="match_parent" android:layout_height="86dp" android:backgroundTint="#E7F8F1" android:textColor="#086C68" android:textAllCaps="false" android:textSize="17sp" android:textStyle="bold" android:gravity="center_vertical" android:text="♣    Club                                          ›"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seguimiento de la regata, visualización de posiciones y resultados." android:textSize="13sp" android:textColor="#5E6E85" android:paddingStart="54dp" android:paddingEnd="12dp"/>
</LinearLayout>
<TextView android:id="@+id/roleDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#0A4D77" android:textSize="14sp" android:layout_marginTop="12dp"/>
<LinearLayout android:id="@+id/loginFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<EditText android:id="@+id/adminUser" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Nombre de usuario" android:inputType="text" android:paddingHorizontal="16dp" android:background="@drawable/card_white"/>
<EditText android:id="@+id/adminPass" android:layout_width="match_parent" android:layout_height="56dp" android:hint="Contraseña" android:inputType="textPassword" android:paddingHorizontal="16dp" android:layout_marginTop="8dp" android:background="@drawable/card_white"/>
<Button android:id="@+id/adminLogin" android:layout_width="match_parent" android:layout_height="56dp" android:text="ACCEDER" android:layout_marginTop="10dp" android:backgroundTint="#087CAF" android:textColor="#FFFFFF"/>
</LinearLayout>
<TextView android:id="@+id/adminMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C62828" android:gravity="center" android:layout_marginTop="8dp"/>
<LinearLayout android:id="@+id/adminPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Panel de gestión" android:textStyle="bold" android:textSize="20sp" android:textColor="#102A43"/>
<Button android:id="@+id/newRegatta" android:layout_width="match_parent" android:layout_height="54dp" android:text="+ NUEVA REGATA"/>
<Button android:id="@+id/manageRaces" android:layout_width="match_parent" android:layout_height="54dp" android:text="DÍAS Y PRUEBAS"/>
<Button android:id="@+id/manageCourse" android:layout_width="match_parent" android:layout_height="54dp" android:text="CAMPO DE REGATAS · BOYAS GPS"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔒  Acceso exclusivo para Organización / Clubes" android:textSize="12sp" android:textColor="#74849B" android:gravity="center" android:layout_marginTop="26dp" android:layout_marginBottom="18dp"/>
</LinearLayout></LinearLayout></ScrollView>