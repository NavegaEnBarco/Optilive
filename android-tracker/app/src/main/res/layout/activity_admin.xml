<Button android:id="@+id/newRegatta" android:layout_width="match_parent" android:layout_height="54dp" android:text="+ NUEVA REGATA" android:backgroundTint="#087EC1" android:textColor="#FFFFFF"/>
<Button android:id="@+id/manageRaces" android:layout_width="match_parent" android:layout_height="54dp" android:text="DÍAS Y PRUEBAS" android:backgroundTint="#087EC1" android:textColor="#FFFFFF"/>
<Button android:id="@+id/manageCourse" android:layout_width="match_parent" android:layout_height="54dp" android:text="CAMPO DE REGATAS · BOYAS GPS" android:backgroundTint="#087EC1" android:textColor="#FFFFFF"/>
</LinearLayout>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="♙" android:textSize="26sp" android:textColor="#8AB5D4" android:gravity="center" android:layout_marginTop="40dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Acceso exclusivo para Organización / Clubes" android:textSize="13sp" android:textColor="#A2BBD0" android:gravity="center" android:layout_marginTop="8dp"/>
</LinearLayout>
</ScrollView>
</FrameLayout>